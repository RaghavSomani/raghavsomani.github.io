{
  "name": "raghavsomani-github-io",
  "version": "1.0.0",
  "description": "Build scripts for Raghav Somani's personal website",
  "repository": {
    "type": "git",
    "url": "https://github.com/RaghavSomani/raghavsomani.github.io.git"
  },
  "keywords": [
    "jekyll",
    "academic-portfolio",
    "personal-website"
  ],
  "author": "Raghav Somani",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RaghavSomani/raghavsomani.github.io/issues"
  },
  "homepage": "https://raghavsomani.github.io/",
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  },
  "devDependencies": {
    "@mathjax/src": "4.1.3",
    "axe-core": "4.14.0",
    "html-validate": "11.21.1",
    "onchange": "7.1.0",
    "playwright": "1.65.1",
    "sharp": "0.35.5",
    "subset-font": "2.9.0",
    "uglify-js": "3.19.3"
  },
  "scripts": {
    "build": "bundle exec jekyll build --trace && node scripts/prerender-math.mjs _site",
    "preview": "node scripts/preview-server.mjs",
    "uglify": "uglifyjs assets/js/_main.js -c -m -o assets/js/main.min.js && uglifyjs assets/js/vendor/jquery/jquery-4.0.0.min.js assets/js/plugins/jquery.magnific-popup.js assets/js/_image-viewer.js --comments '/^!/' -c -m -o assets/js/image-viewer.min.js",
    "watch:js": "onchange \"assets/js/**/*.js\" -e \"assets/js/*.min.js\" -- npm run build:js",
    "build:js": "npm run uglify",
    "build:images": "node scripts/build-images.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "check:accessibility": "node scripts/check-accessibility.mjs _site",
    "check:lightbox": "node scripts/check-lightbox.mjs",
    "check:links": "node scripts/check-internal-links.mjs _site",
    "check:html": "html-validate --rule close-order:error --rule element-permitted-content:error --rule element-permitted-parent:error --rule no-dup-id:error \"_site/**/*.html\""
  }
}
